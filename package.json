  "homepage": "https://github.com/LolipopJ/PixivPreviewer",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jquery": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/tampermonkey": "^5.5.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
